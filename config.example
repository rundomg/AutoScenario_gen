# AutoScenario Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_KEY=your-openai-api-key-here
OPENAI_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=30
OPENAI_SYSTEM_PROMPT=You are a helpful assistant for autonomous vehicle scenario generation.

# Optional: Additional API configurations
# OPENAI_BASE_URL=https://your-custom-endpoint.com
# OPENAI_API_VERSION=2024-02-15-preview
